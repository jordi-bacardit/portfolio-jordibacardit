---
// Click-to-load YouTube player. Until someone presses Play nothing is requested from
// YouTube (no cookies, no third-party script): the poster is a local image. Without JS
// it stays a plain link to the video on YouTube. The player uses youtube-nocookie.com.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  url: string;
  /** Names the video for the Play button and the player. */
  title: string;
  poster?: ImageMetadata;
}

const { url, title, poster } = Astro.props;

const id = url.match(/(?:youtu\.be\/|[?&]v=|\/embed\/|\/shorts\/|\/live\/)([\w-]{11})/)?.[1];
if (!id) {
  throw new Error(`Can't find a YouTube video id in "${url}".`);
}
---

<div class="video" data-youtube-id={id} data-youtube-title={title} data-cursor="Play">
  <a class="facade" href={`https://www.youtube.com/watch?v=${id}`} data-youtube-play>
    {
      poster ? (
        <Image
          src={poster}
          alt=""
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 90rem) 90rem, 100vw"
          class="poster"
        />
      ) : (
        <span class="poster-title" aria-hidden="true">
          {title}
        </span>
      )
    }
    <span class="play">
      <span class="icon" aria-hidden="true"></span>
      <span>Play <span class="visually-hidden">{title}</span></span>
    </span>
  </a>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-youtube-id]').forEach((container) => {
    const link = container.querySelector<HTMLAnchorElement>('[data-youtube-play]');
    if (!link) return;

    // With JS the facade acts in place, so it becomes a real button (keeping the scoped attributes).
    const button = document.createElement('button');
    button.type = 'button';
    for (const attribute of link.attributes) {
      if (attribute.name !== 'href') button.setAttribute(attribute.name, attribute.value);
    }
    button.append(...link.childNodes);
    link.replaceWith(button);

    button.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${container.dataset.youtubeId}?autoplay=1&rel=0`;
      iframe.title = container.dataset.youtubeTitle ?? 'YouTube video';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      container.replaceChildren(iframe);
      delete container.dataset.cursor; // the player is live: no "Play" cursor label any more
      iframe.focus();
    });
  });
</script>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: var(--border-thin) solid var(--color-line);
    background: var(--color-surface);
  }

  .video :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .facade {
    display: grid;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .facade > * {
    grid-area: 1 / 1;
  }

  .poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .facade:hover .poster {
    transform: scale(1.03);
  }

  .poster-title {
    align-self: start;
    padding: var(--space-l);
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    text-transform: uppercase;
  }

  .play {
    display: inline-flex;
    align-items: center;
    gap: var(--space-s);
    align-self: end;
    justify-self: start;
    min-height: var(--tap-min);
    margin: var(--space-l);
    padding: var(--space-s) var(--space-l);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .facade:hover .play {
    background: var(--color-text);
  }

  @media (min-width: 48em) {
    .poster-title {
      font-size: var(--text-2xl);
    }
  }

  .icon {
    width: 0.75rem;
    height: 0.875rem;
    background: currentColor;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }
</style>
