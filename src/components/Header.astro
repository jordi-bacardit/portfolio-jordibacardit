---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const [firstName, ...lastName] = site.name.split(' ');

// "page" for the exact page, "true" for a section ancestor (e.g. Work on /work/<slug>).
function current(href: string) {
  if (path === href) return 'page';
  if (path.startsWith(`${href}/`)) return 'true';
  return undefined;
}
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href="/">
      <Logo size={40} />
      <span class="brand-name">
        <span>{firstName}</span>{" "}
        <span>{lastName.join(' ')}</span>
      </span>
    </a>
    <p class="role">{site.role}</p>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      Menu
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href)} data-scramble>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="status"><span class="dot" aria-hidden="true"></span>{site.status}</p>
  </div>
  <span class="progress" aria-hidden="true"></span>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('site-nav');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.toggleAttribute('data-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // The desktop nav is always visible, so reset the state when the layout switches.
    window.matchMedia('(min-width: 48em)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: var(--border-thin) solid var(--color-line);
    background: var(--color-bg);
    view-transition-name: site-header;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-l);
    min-height: var(--header-height);
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-xs) var(--gutter);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-s);
    min-height: var(--tap-min);
    text-decoration: none;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .brand-name span {
    display: block;
  }

  .brand:hover .brand-name {
    color: var(--color-accent);
  }

  .role,
  .status {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    line-height: 1.3;
    text-transform: uppercase;
  }

  .role {
    display: none;
  }

  .status {
    display: none;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-text);
  }

  .dot {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-accent);
  }

  .menu-toggle {
    min-width: var(--tap-min);
    min-height: var(--tap-min);
    padding: 0 var(--space-m);
    border: var(--border-thin) solid var(--color-text-muted);
    background: transparent;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .menu-toggle:hover,
  .menu-toggle[aria-expanded='true'] {
    border-color: var(--color-accent);
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-l);
  }

  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .site-nav a:hover,
  .site-nav a[aria-current] {
    color: var(--color-accent);
  }

  .site-nav a[aria-current]::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.4rem;
    left: 0;
    height: var(--border-strong);
    background: var(--color-accent);
  }

  /* Scroll progress: a CSS scroll-driven animation, so browsers without support simply don't show it. */
  .progress {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: var(--border-strong);
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .progress {
        animation: scroll-progress linear both;
      }

      /* Kept in its own rule on purpose: the CSS minifier would otherwise fold the timeline into
         the animation shorthand, which browsers reject (the shorthand can't carry a timeline). */
      .site-header .progress {
        animation-timeline: scroll(root);
      }
    }
  }

  @keyframes scroll-progress {
    to {
      transform: scaleX(1);
    }
  }

  /* Without JS the links stay visible as a wrapping row; the toggle only exists with JS. */
  :global(.no-js) .menu-toggle {
    display: none;
  }

  :global(.no-js) .site-nav {
    width: 100%;
  }

  @media (max-width: 47.99em) {
    :global(.js) .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      padding: var(--space-m) var(--gutter) var(--space-xl);
      border-bottom: var(--border-thin) solid var(--color-line);
      background: var(--color-bg);
    }

    :global(.js) .site-nav[data-open] {
      display: block;
    }

    :global(.js) .site-nav ul {
      flex-direction: column;
    }

    :global(.js) .site-nav a {
      font-size: var(--text-2xl);
      letter-spacing: var(--tracking-display);
      line-height: 1.05;
    }

    :global(.js) .site-nav a[aria-current]::after {
      bottom: 0.2rem;
    }
  }

  @media (min-width: 48em) {
    .menu-toggle {
      display: none;
    }

    :global(.no-js) .site-nav {
      width: auto;
    }

    .site-nav {
      margin-left: auto;
    }
  }

  @media (min-width: 64em) {
    .status {
      display: flex;
    }
  }

  @media (min-width: 80em) {
    .role {
      display: block;
    }
  }
</style>
