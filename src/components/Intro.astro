---
// Home intro: the name assembles, an accent seam crosses the screen and the two halves
// open onto the page. Only shown while <html> has .intro-play, which BaseLayout sets before
// paint once per session (never without JS or with reduced motion). The whole timeline is
// CSS, so the overlay removes itself even if the script below never runs. The page content
// is in the DOM underneath from the start.
import SplitText from './SplitText.astro';
import { site } from '../data/site';
---

<div class="intro" aria-hidden="true">
  <div class="panel top"></div>
  <div class="panel bottom"></div>
  <span class="seam"></span>
  <div class="content">
    <p class="name"><SplitText text={site.name} /></p>
    <p class="role">{site.role}</p>
  </div>
</div>

<script>
  // Any click, key, scroll or touch skips the intro.
  const root = document.documentElement;
  if (root.classList.contains('intro-play')) {
    const end = () => root.classList.remove('intro-play');
    const events = ['pointerdown', 'keydown', 'wheel', 'touchstart'] as const;
    const skip = () => {
      end();
      events.forEach((type) => window.removeEventListener(type, skip));
    };
    events.forEach((type) => window.addEventListener(type, skip, { passive: true }));
    window.setTimeout(skip, 2250);
  }
</script>

<style>
  .intro {
    display: none;
  }

  :global(html.intro-play) .intro {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 1000;
    animation: intro-gone 0s linear 2.15s forwards;
  }

  .panel {
    position: absolute;
    right: 0;
    left: 0;
    height: 50.5%;
    background: var(--color-bg);
  }

  .top {
    top: 0;
    animation: open-up 700ms cubic-bezier(0.76, 0, 0.24, 1) 1.4s forwards;
  }

  .bottom {
    bottom: 0;
    animation: open-down 700ms cubic-bezier(0.76, 0, 0.24, 1) 1.4s forwards;
  }

  .seam {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: var(--border-strong);
    background: var(--color-accent);
    transform: scaleX(0);
    animation:
      seam-grow 500ms var(--ease-out) 0.95s forwards,
      intro-fade 250ms ease-in 1.5s forwards;
  }

  .content {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-l);
    padding: var(--gutter);
    text-align: center;
    animation: content-out 350ms ease-in 1.1s forwards;
  }

  .name {
    max-width: none;
    font-family: var(--font-display);
    font-size: clamp(3rem, 11vw, 10rem);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    text-transform: uppercase;
  }

  .role {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    animation: role-in 400ms var(--ease-out) 0.45s both;
  }

  @keyframes open-up {
    to {
      transform: translateY(-100%);
    }
  }

  @keyframes open-down {
    to {
      transform: translateY(100%);
    }
  }

  @keyframes seam-grow {
    to {
      transform: scaleX(1);
    }
  }

  @keyframes intro-fade {
    to {
      opacity: 0;
    }
  }

  @keyframes content-out {
    to {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  @keyframes role-in {
    from {
      opacity: 0;
    }
  }

  @keyframes intro-gone {
    to {
      visibility: hidden;
    }
  }
</style>
