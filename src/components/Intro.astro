---
// Home gate: the name assembles, rises and becomes a menu. "Play" opens the 3D village (/play);
// "Read" lifts the gate off the classic portfolio, which is in the DOM underneath from the start,
// so search engines and people without JS get the page straight away.
// BaseLayout adds html.gate-open before paint, only with JS and only when the site is opened (not
// when coming back to the home from inside the site); after the first time it's the short
// version (gate-quick: straight to the menu). Deep links (/work, /about...) never see it.
// If the script below never runs, CSS removes the gate after a few seconds: it can't trap anyone.
import SplitText from './SplitText.astro';
import { site } from '../data/site';
---

<div
  class="gate"
  role="dialog"
  aria-modal="true"
  aria-labelledby="gate-title"
  tabindex="-1"
  data-gate
  data-state="intro"
>
  <div class="content">
    <div class="head">
      <p class="name" id="gate-title"><SplitText text={site.name} variant="rise" /></p>
      <p class="role">{site.role}</p>
    </div>
    <div class="choices">
      <ul class="menu" role="list">
        <li>
          <a class="option" href="/play" data-gate-option data-gate-play>
            <span class="option-name">Play</span>
            <span class="option-text" data-gate-play-text>Walk through the portfolio in 3D</span>
          </a>
        </li>
        <li>
          <button class="option" type="button" data-gate-option data-gate-read>
            <span class="option-name">Read</span>
            <span class="option-text">Open the classic portfolio</span>
          </button>
        </li>
      </ul>
      <p class="notice" data-gate-notice hidden></p>
      <p class="hint">Arrow keys to choose, Enter to confirm</p>
    </div>
  </div>
</div>

<script>
  import { prefersReducedMotion, supportsWebGL } from '../scripts/support';

  const root = document.documentElement;
  const gate = document.querySelector<HTMLElement>('[data-gate]');
  const play = gate?.querySelector<HTMLAnchorElement>('[data-gate-play]');
  const read = gate?.querySelector<HTMLButtonElement>('[data-gate-read]');

  if (gate && play && read && root.classList.contains('gate-open')) {
    // Tells the CSS safety net that the gate is handled.
    root.dataset.gateReady = '';
    const options = [...gate.querySelectorAll<HTMLElement>('[data-gate-option]')];
    const notice = gate.querySelector<HTMLElement>('[data-gate-notice]');
    const playText = gate.querySelector<HTMLElement>('[data-gate-play-text]');
    // Everything but the gate stays out of reach (focus, clicks, screen readers) while it's open.
    const page = [...document.body.children].filter(
      (element): element is HTMLElement => element !== gate && element instanceof HTMLElement,
    );
    page.forEach((element) => (element.inert = true));

    try {
      localStorage.setItem('gate-visited', '1');
    } catch {}

    const disabled = (option: HTMLElement) => option.getAttribute('aria-disabled') === 'true';
    if (!supportsWebGL()) {
      play.setAttribute('aria-disabled', 'true');
      if (playText) playText.textContent = "This browser can't run the 3D version";
    } else if (prefersReducedMotion() && notice) {
      notice.hidden = false;
      notice.textContent = 'The 3D version has a lot of camera movement, so Read is recommended.';
    }

    let state: 'intro' | 'menu' | 'closing' = 'intro';

    const showMenu = () => {
      if (state !== 'intro') return;
      state = 'menu';
      gate.dataset.state = 'menu';
      read.focus({ preventScroll: true });
    };

    const close = (instant = false) => {
      if (state === 'closing') return;
      state = 'closing';
      gate.dataset.state = 'closing';
      page.forEach((element) => (element.inert = false));
      (document.activeElement as HTMLElement | null)?.blur();
      window.setTimeout(() => root.classList.remove('gate-open'), instant ? 0 : 400);
    };

    play.addEventListener('click', (event) => {
      if (disabled(play)) event.preventDefault();
    });
    read.addEventListener('click', () => close());

    // While the name assembles, a click, tap, Enter, Space or Esc jumps to the menu. The click
    // that ends that same tap must not then choose the option under the finger: the menu takes
    // clicks as soon as it shows, before it has faded in.
    let skippedAt = -Infinity;
    gate.addEventListener('pointerdown', (event) => {
      if (state === 'intro') {
        event.preventDefault();
        skippedAt = event.timeStamp;
        showMenu();
      }
    });
    gate.addEventListener(
      'click',
      (event) => {
        if (event.timeStamp - skippedAt < 600) {
          event.preventDefault();
          event.stopPropagation();
        }
      },
      true,
    );

    window.addEventListener('keydown', (event) => {
      if (state === 'intro') {
        if (['Enter', ' ', 'Escape'].includes(event.key)) {
          event.preventDefault();
          showMenu();
        }
        return;
      }
      if (state !== 'menu') return;
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
        return;
      }
      // The options sit side by side; up/down work too, for people who reach for them.
      const next = ['ArrowRight', 'ArrowDown'].includes(event.key);
      if (next || ['ArrowLeft', 'ArrowUp'].includes(event.key)) {
        event.preventDefault();
        const enabled = options.filter((option) => !disabled(option));
        const current = enabled.indexOf(document.activeElement as HTMLElement);
        const step = next ? 1 : -1;
        enabled[(current + step + enabled.length) % enabled.length]?.focus();
      }
    });

    // With a mouse, pointing at an option selects it, like a game menu.
    options.forEach((option) =>
      option.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse' && state === 'menu' && !disabled(option)) {
          option.focus({ preventScroll: true });
        }
      }),
    );

    // Back from /play (page restored from the back/forward cache): the choice is already made.
    window.addEventListener('pageshow', (event) => {
      if (event.persisted && state !== 'closing') close(true);
    });

    const quick = root.classList.contains('gate-quick') || prefersReducedMotion();
    if (quick) {
      showMenu();
    } else {
      gate.focus({ preventScroll: true });
      window.setTimeout(showMenu, 1500);
    }
  }
</script>

<style>
  .gate {
    display: none;
  }

  :global(html.gate-open) .gate {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    overflow-y: auto;
    padding: var(--gutter);
    background: var(--color-bg);
    transition: opacity var(--duration-slow) var(--ease-out);
  }

  /* The page underneath doesn't scroll while the gate is up (only once the script handles it). */
  :global(html.gate-open[data-gate-ready]) {
    overflow: hidden;
  }

  /* Safety net: if the script never runs, the gate gets out of the way. */
  :global(html.gate-open:not([data-gate-ready])) .gate {
    animation: gate-bail 0s linear 5s forwards;
  }

  .gate:focus {
    outline: none;
  }

  .gate[data-state='closing'] {
    opacity: 0;
    pointer-events: none;
  }

  .content {
    display: grid;
    gap: var(--space-2xl);
    justify-items: center;
    width: min(100%, 60rem);
    text-align: center;
  }

  /* The name starts centred on its own, then rises to make room for the menu. */
  .head {
    display: grid;
    gap: var(--space-m);
    justify-items: center;
    transform: translateY(clamp(5rem, 2rem + 9vw, 11rem));
    transition: transform 900ms var(--ease-out);
  }

  .gate:not([data-state='intro']) .head {
    transform: none;
  }

  .name {
    max-width: none;
    overflow: hidden;
    padding-bottom: 0.08em;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 10vw, 8.5rem);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    text-transform: uppercase;
  }

  .role {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    animation: gate-fade 500ms var(--ease-out) 600ms both;
  }

  .choices {
    display: grid;
    gap: var(--space-l);
    justify-items: center;
    opacity: 0;
    transform: translateY(1.5rem);
    transition:
      opacity 500ms var(--ease-out),
      transform 700ms var(--ease-out);
    pointer-events: none;
  }

  .gate:not([data-state='intro']) .choices {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition-delay: 200ms;
  }

  /* Skipping, or a returning visitor: the letters don't replay. */
  .gate:not([data-state='intro']) :global(.char),
  :global(html.gate-quick) .gate :global(.char) {
    animation: none;
  }

  :global(html.gate-quick) .role {
    animation: none;
  }

  /* Play on the left, Read on the right, as two equal columns centred under the name. */
  .menu {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l);
    width: min(100%, 48rem);
  }

  /* A game menu: the selected option turns accent and an accent bar grows under it. */
  .option {
    display: grid;
    gap: var(--space-xs);
    justify-items: center;
    align-content: start;
    width: 100%;
    min-height: var(--tap-min);
    padding: var(--space-m) var(--space-s);
    border: 0;
    background: none;
    color: var(--color-text-muted);
    text-align: center;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .option::after {
    content: '';
    width: 3rem;
    height: var(--border-strong);
    margin-top: var(--space-xs);
    background: var(--color-accent);
    transform: scaleX(0);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .option:is(:hover, :focus):not([aria-disabled='true']) {
    color: var(--color-accent);
  }

  .option:is(:hover, :focus):not([aria-disabled='true'])::after {
    transform: none;
  }

  .option[aria-disabled='true'] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .option-name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    text-transform: uppercase;
  }

  .option-text {
    text-wrap: balance;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .notice {
    max-width: 30rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .hint {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  /* Touch screens: no keyboard hint. */
  @media (hover: none) {
    .hint {
      display: none;
    }
  }

  @keyframes gate-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes gate-bail {
    to {
      visibility: hidden;
    }
  }
</style>
