---
import { Font } from 'astro:assets';
import Effects from '../components/Effects.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Intro from '../components/Intro.astro';
import { site } from '../data/site';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  /** Page name, e.g. "Work". Omit on the home page. */
  title?: string;
  description: string;
  /** Root-relative or absolute URL of the Open Graph image. */
  image?: string;
  /** Play the name intro (once per session). Home page only. */
  intro?: boolean;
}

const { title, description, image, intro = false } = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Share image: the page's own (e.g. a project cover) or the default 1200×630 card in public/og.jpg.
const ogImage = Astro.site ? new URL(image ?? '/og.jpg', Astro.site).href : undefined;
const ogImageIsDefault = !image;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    {
      intro && (
        <script is:inline>
          try {
            if (
              !matchMedia('(prefers-reduced-motion: reduce)').matches &&
              !sessionStorage.getItem('intro-seen')
            ) {
              sessionStorage.setItem('intro-seen', '1');
              document.documentElement.classList.add('intro-play');
            }
          } catch (error) {}
        </script>
      )
    }
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <!-- Favicons generated from src/assets/logo.png. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {
      ogImage && ogImageIsDefault && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta
            property="og:image:alt"
            content={`${site.name}, ${site.role}. Portrait and name on a dark background.`}
          />
        </>
      )
    }
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <Font cssVariable="--font-familjen-grotesk" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-jetbrains-mono" />
  </head>
  <body>
    {intro && <Intro />}
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Effects />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-xs);
    left: var(--space-xs);
    z-index: 100;
    padding: var(--space-s) var(--space-m);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  main {
    flex: 1;
  }
</style>
