---
import { Image } from 'astro:assets';
import Container from '../components/Container.astro';
import Placeholder from '../components/Placeholder.astro';
import SplitText from '../components/SplitText.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGameGroups } from '../lib/games';
import { paragraphs } from '../lib/text';

const groups = await getGameGroups();
---

<BaseLayout
  title="Game Library"
  description="A personal archive of the games I play and the games that shaped me."
>
  <Container class="intro">
    <h1><SplitText text="Game Library." /></h1>
    <p class="lead">A personal archive of the games I play and the games that shaped me.</p>
  </Container>

  {
    groups.length === 0 ? (
      <Container>
        <p>
          <Placeholder label="add games" />
        </p>
      </Container>
    ) : (
      groups.map((group) => (
        <Container as="section" class="group" aria-labelledby={`status-${group.status}`}>
          <h2 id={`status-${group.status}`} class="group-title">
            {group.label}.
          </h2>
          <ul role="list" class="games">
            {group.games.map((game) => {
              const { image } = game.data;
              return (
                <li class="game">
                  <div class:list={['cover', { 'has-image': image }]}>
                    {image ? (
                      <Image
                        src={image}
                        alt={game.data.imageAlt || `Screenshot of ${game.data.title}`}
                        widths={[360, 720]}
                        sizes="(min-width: 64em) 16rem, 50vw"
                      />
                    ) : (
                      <span class="cover-title" aria-hidden="true">
                        {game.data.title}
                      </span>
                    )}
                  </div>
                  <h3>{game.data.title}</h3>
                  <dl class="facts">
                    <div>
                      <dt>Genre</dt>
                      <dd>{game.data.genre}</dd>
                    </div>
                    <div>
                      <dt>Platforms</dt>
                      <dd>{game.data.platforms.join(', ')}</dd>
                    </div>
                  </dl>
                  {paragraphs(game.data.note).map((paragraph) => (
                    <p class="note">{paragraph}</p>
                  ))}
                </li>
              );
            })}
          </ul>
        </Container>
      ))
    )
  }
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: var(--space-l);
    padding-block: var(--space-2xl);
  }

  .lead {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .group {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-xl);
  }

  .group-title {
    font-size: var(--text-2xl);
    color: var(--color-text-muted);
  }

  .games {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-2xl) var(--space-l);
  }

  .game {
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }

  .cover {
    display: flex;
    align-items: flex-end;
    aspect-ratio: 2 / 3;
    margin-bottom: var(--space-xs);
    overflow: hidden;
    border: var(--border-thin) solid var(--color-line);
    background: var(--color-surface);
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .game:hover .cover {
    border-color: var(--color-accent);
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .game:hover .cover :global(img) {
    transform: scale(1.03);
  }

  .cover-title {
    padding: var(--space-m);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-l);
  }

  .note {
    color: var(--color-text-muted);
  }
</style>
