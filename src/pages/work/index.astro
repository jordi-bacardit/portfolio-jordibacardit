---
import Container from '../../components/Container.astro';
import ProjectList from '../../components/ProjectList.astro';
import SplitText from '../../components/SplitText.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<BaseLayout
  title="Work"
  description="Video game projects by Jordi Bacardit, built in Unity and Unreal Engine, plus an upcoming Final Degree Project."
>
  <Container class="page">
    <div class="intro">
      <h1><SplitText text="Work." /></h1>
      <p class="lead">
        Video game projects built in Unity and Unreal Engine, plus my upcoming Final Degree Project.
      </p>
    </div>
    <ProjectList projects={projects} eager />
  </Container>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-2xl);
    padding-top: var(--space-2xl);
  }

  .intro {
    display: grid;
    gap: var(--space-l);
  }

  .lead {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  @media (min-width: 64em) {
    .intro {
      grid-template-columns: 2fr 1fr;
      align-items: end;
    }
  }
</style>
