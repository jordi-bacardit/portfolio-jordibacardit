---
import Container from '../../components/Container.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectList from '../../components/ProjectList.astro';
import SplitText from '../../components/SplitText.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjectGroups } from '../../lib/projects';

const { main, prototypes } = await getProjectGroups();
---

<BaseLayout
  title="Work"
  description="Video game projects by Jordi Bacardit, built in Unity and Unreal Engine, plus an upcoming Final Degree Project."
>
  <Container class="page">
    <div class="intro">
      <h1><SplitText text="Work." /></h1>
      <p class="lead">
        Video game projects built in Unity and Unreal Engine, plus my upcoming Final Degree Project.
      </p>
    </div>
    <ProjectList projects={main} eager />
  </Container>

  {
    prototypes.length > 0 && (
      <Container as="section" class="prototypes" aria-labelledby="prototypes-title">
        <h2 id="prototypes-title">Prototypes.</h2>
        <div class="prototype-grid">
          {prototypes.map((project) => (
            <ProjectCard project={project} size="mini" headingLevel={3} />
          ))}
        </div>
      </Container>
    )
  }
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-2xl);
    padding-top: var(--space-2xl);
  }

  .intro {
    display: grid;
    gap: var(--space-l);
  }

  .lead {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  /* Smaller and quieter than the main grid: a heading and one row of cards. */
  .prototypes {
    display: grid;
    gap: var(--space-xl);
    padding-top: var(--space-3xl);
  }

  .prototypes h2 {
    font-size: var(--text-2xl);
  }

  .prototype-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-m);
  }

  @media (min-width: 64em) {
    .intro {
      grid-template-columns: 2fr 1fr;
      align-items: end;
    }
  }
</style>
