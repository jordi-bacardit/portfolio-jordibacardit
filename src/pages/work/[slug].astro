---
// The one template every project page uses. The case study is the project file's own list of
// sections, in its order; each block only renders when it has data, so pages never show empty
// headings.
import { getImage, Image, Picture } from 'astro:assets';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import CategoryList from '../../components/CategoryList.astro';
import Container from '../../components/Container.astro';
import ProgressionDiagram from '../../components/ProgressionDiagram.astro';
import ProjectMeta from '../../components/ProjectMeta.astro';
import YouTubeVideo from '../../components/YouTubeVideo.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  caseStudyInProgress,
  caseStudyMissing,
  getProjectGroups,
  projectLinks,
  toCategories,
  transitionStyles,
  type Project,
} from '../../lib/projects';
import { paragraphs } from '../../lib/text';

// Previous/next runs through the main projects only; prototypes get no pager.
export async function getStaticPaths() {
  const { main, prototypes } = await getProjectGroups();
  return [
    ...main.map((project, index) => ({
      params: { slug: project.id },
      props: { project, prev: main[index - 1], next: main[index + 1] },
    })),
    ...prototypes.map((project) => ({ params: { slug: project.id }, props: { project } })),
  ];
}

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}

const { project, prev, next } = Astro.props;
const {
  title,
  summary,
  cover,
  coverAlt,
  trailer,
  trailerPoster,
  gameplay,
  gallery,
  links,
  sections,
  technicalNotes,
} = project.data;

// The card's title and cover morph into these (see transitionStyles).
const morph = transitionStyles(project.id);
const inProgress = caseStudyInProgress(project.data);
// Names only what's still missing, so the note never promises something already on the page.
const missing = caseStudyMissing(project.data);
const inProgressNote =
  missing.media && missing.writeUp
    ? 'Gameplay, screenshots and production notes are on the way.'
    : missing.media
      ? 'Gameplay and screenshots are on the way.'
      : 'Production notes are on the way.';
const ogImage = cover ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src : undefined;

// Normalised sections: blank blocks dropped, and a section with nothing left isn't shown.
const slugify = (text: string) =>
  text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
const caseStudy = (sections ?? [])
  .map((section) => ({
    id: `section-${slugify(section.title)}`,
    title: section.title.trim(),
    text: paragraphs(section.text),
    diagram: section.diagram,
    lists: toCategories(section.lists),
    entries: (section.entries ?? [])
      .map((entry) => ({
        label: entry.label?.trim(),
        title: entry.title.trim(),
        text: paragraphs(entry.text),
      }))
      .filter((entry) => entry.title),
    note: section.note?.trim(),
  }))
  .filter(
    (section) =>
      section.title &&
      (section.text.length > 0 ||
        section.diagram ||
        section.lists.length > 0 ||
        section.entries.length > 0 ||
        section.note),
  );
const notesText = paragraphs(technicalNotes);
const clips = gameplay ?? [];
const shots = gallery ?? [];
const allLinks = projectLinks(links);
// The hero carries the main actions; the closing Links section lists them all.
const heroLinks = allLinks.slice(0, 2);
---

<BaseLayout title={title} description={summary} image={ogImage}>
  <article>
    {/* 1. Hero: what it is and the key facts */}
    <Container as="header" class="hero">
      <div class="heading">
        <h1 style={morph.title}>{title}</h1>
        <p class="pitch">{summary}</p>
        {
          inProgress && (
            <p class="wip">
              <Badge live>Case study in progress</Badge>{" "}
              <span>{inProgressNote}</span>
            </p>
          )
        }
      </div>
      <aside class="details" aria-label="Project details">
        <ProjectMeta project={project.data} />
        {
          heroLinks.length > 0 && (
            <div class="actions">
              {heroLinks.map((link, index) => (
                <Button href={link.href} variant={index === 0 ? 'primary' : 'secondary'}>
                  {link.label}
                </Button>
              ))}
            </div>
          )
        }
      </aside>
    </Container>

    {/* 2. Main visual: the video takes priority, otherwise the cover */}
    {
      trailer ? (
        <Container as="section" class="feature" aria-label={`${title} trailer`}>
          <YouTubeVideo url={trailer} title={`${title} trailer`} poster={trailerPoster ?? cover} />
        </Container>
      ) : (
        cover && (
          <Container class="feature cover">
            <Picture
              src={cover}
              alt={coverAlt ?? ''}
              formats={['avif', 'webp']}
              widths={[640, 960, 1280, 1920, 2560]}
              sizes="(min-width: 90rem) 90rem, 100vw"
              loading="eager"
              fetchpriority="high"
              style={morph.cover}
            />
          </Container>
        )
      )
    }

    {/* 3. The case study: the project file's sections, in order */}
    {
      caseStudy.length > 0 && (
        <Container class="body">
          {caseStudy.map((section) => (
            <section class="text-section" aria-labelledby={section.id}>
              <h2 id={section.id}>{`${section.title}.`}</h2>
              <div class="stack">
                {section.text.length > 0 && (
                  <div class="prose">
                    {section.text.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                )}
                {section.diagram && (
                  <ProgressionDiagram
                    steps={section.diagram.steps}
                    levers={section.diagram.levers}
                    caption={section.diagram.caption}
                  />
                )}
                {section.lists.length > 0 && <CategoryList groups={section.lists} />}
                {section.entries.length > 0 && (
                  <div class="stack">
                    {section.entries.map((entry) => (
                      <div class="sub">
                        {entry.label && <p class="label">{entry.label}</p>}
                        <h3>{entry.title}</h3>
                        {entry.text.length > 0 && (
                          <div class="prose">
                            {entry.text.map((paragraph) => (
                              <p>{paragraph}</p>
                            ))}
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                )}
                {section.note && <p class="note">{section.note}</p>}
              </div>
            </section>
          ))}
        </Container>
      )
    }

    {/* 4. Gameplay: extra video clips */}
    {
      clips.length > 0 && (
        <Container as="section" class="media-section" aria-labelledby="gameplay-title">
          <h2 id="gameplay-title">Gameplay.</h2>
          <div class="grid">
            {clips.map((clip) => (
              <figure>
                <YouTubeVideo url={clip.video} title={clip.title} poster={clip.poster} />
                {clip.poster && <figcaption>{clip.title}</figcaption>}
              </figure>
            ))}
          </div>
        </Container>
      )
    }

    {/* 5. Screenshots and GIFs (GIFs served as-is: converting them would drop the animation) */}
    {
      shots.length > 0 && (
        <Container as="section" class="media-section" aria-labelledby="screenshots-title">
          <h2 id="screenshots-title">Screenshots.</h2>
          <ul role="list" class="grid">
            {shots.map((shot) => (
              <li>
                {shot.image.format === 'gif' ? (
                  <img
                    src={shot.image.src}
                    width={shot.image.width}
                    height={shot.image.height}
                    alt={shot.alt}
                    loading="lazy"
                    decoding="async"
                    class="shot"
                  />
                ) : (
                  <Image
                    src={shot.image}
                    alt={shot.alt}
                    widths={[640, 960, 1280]}
                    sizes="(min-width: 48em) 50vw, 100vw"
                    class="shot"
                  />
                )}
              </li>
            ))}
          </ul>
        </Container>
      )
    }

    {/* 6. Technical notes and links */}
    {
      (notesText.length > 0 || allLinks.length > 0) && (
        <Container class="body closing">
          {notesText.length > 0 && (
            <section class="text-section" aria-labelledby="technical-notes-title">
              <h2 id="technical-notes-title">Technical notes.</h2>
              <div class="prose">
                {notesText.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </section>
          )}
          {allLinks.length > 0 && (
            <section class="text-section" aria-labelledby="links-title">
              <h2 id="links-title">Links.</h2>
              <div class="actions">
                {allLinks.map((link, index) => (
                  <Button href={link.href} variant={index === 0 ? 'primary' : 'secondary'}>
                    {link.label}
                  </Button>
                ))}
              </div>
            </section>
          )}
        </Container>
      )
    }
  </article>

  {
    (prev || next) && (
      <Container as="nav" class="pager" aria-label="More projects">
        {prev && (
          <a class="prev" href={`/work/${prev.id}`} rel="prev">
            <span class="direction">Previous project</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        )}
        {next && (
          <a class="next" href={`/work/${next.id}`} rel="next">
            <span class="direction">Next project</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        )}
      </Container>
    )
  }
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-2xl);
  }

  .heading {
    display: grid;
    gap: var(--space-l);
  }

  .pitch {
    font-size: var(--text-lg);
  }

  .wip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
    color: var(--color-text-muted);
  }

  .details {
    display: grid;
    gap: var(--space-xl);
    align-content: start;
    padding-top: var(--space-l);
    border-top: var(--border-thin) solid var(--color-line);
  }

  .details:not(:has(dl, .actions)) {
    display: none;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .cover :global(img) {
    width: 100%;
    max-height: 80svh;
    object-fit: cover;
    border: var(--border-thin) solid var(--color-line);
  }

  .body {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-2xl);
  }

  /* Each section: heading on the left, content on the right (desktop). */
  .text-section {
    display: grid;
    gap: var(--space-l);
    padding-top: var(--space-l);
    border-top: var(--border-thin) solid var(--color-line);
  }

  .text-section h2 {
    font-size: var(--text-2xl);
  }

  .prose {
    display: grid;
    gap: var(--space-m);
    max-width: 52rem;
    font-size: var(--text-lg);
  }

  .stack {
    display: grid;
    gap: var(--space-xl);
  }

  .label {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .sub {
    display: grid;
    gap: var(--space-s);
  }

  .note {
    max-width: 52rem;
    color: var(--color-text-muted);
  }

  .feature {
    padding-bottom: var(--space-xl);
  }

  .media-section {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-2xl);
  }

  .grid {
    display: grid;
    gap: var(--space-l) var(--space-m);
  }

  figure {
    display: grid;
    gap: var(--space-s);
  }

  figcaption {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .shot {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: var(--border-thin) solid var(--color-line);
  }

  .pager {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-2xl);
  }

  .pager a {
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-xl);
    border-top: var(--border-thin) solid var(--color-line);
    text-decoration: none;
  }

  .direction {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .pager-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    text-transform: uppercase;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .pager a:hover .pager-title {
    color: var(--color-accent);
  }

  @media (min-width: 48em) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .pager {
      grid-template-columns: 1fr 1fr;
    }

    .next {
      grid-column: 2;
      text-align: right;
    }
  }

  @media (min-width: 64em) {
    .hero {
      grid-template-columns: 2fr 1fr;
      align-items: end;
    }

    .text-section {
      grid-template-columns: 1fr 2fr;
      align-items: start;
    }
  }
</style>
