---
// The one template every project page uses. Each section only renders when the project's file
// has data for it, so projects with few fields stay short and never show empty headings.
import { getImage, Image, Picture } from 'astro:assets';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import CategoryList from '../../components/CategoryList.astro';
import Container from '../../components/Container.astro';
import ProjectMeta from '../../components/ProjectMeta.astro';
import YouTubeVideo from '../../components/YouTubeVideo.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  caseStudyInProgress,
  caseStudyMissing,
  getProjects,
  projectLinks,
  toCategories,
  transitionStyles,
  type Project,
} from '../../lib/projects';
import { paragraphs } from '../../lib/text';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: { project, prev: projects[index - 1], next: projects[index + 1] },
  }));
}

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}

const { project, prev, next } = Astro.props;
const {
  title,
  summary,
  role,
  team,
  cover,
  coverAlt,
  trailer,
  trailerPoster,
  gameplay,
  gallery,
  links,
  overview,
  responsibilities,
  development,
  production,
  challenges,
  highlights,
  technologies,
  result,
} = project.data;

// The card's title and cover morph into these (see transitionStyles).
const morph = transitionStyles(project.id);
const inProgress = caseStudyInProgress(project.data);
// Names only what's still missing, so the note never promises something already on the page.
const missing = caseStudyMissing(project.data);
const inProgressNote =
  missing.media && missing.writeUp
    ? 'Gameplay, screenshots and production notes are on the way.'
    : missing.media
      ? 'Gameplay and screenshots are on the way.'
      : 'Production notes are on the way.';
const ogImage = cover ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src : undefined;

// Normalised content: blank entries dropped so a section only shows when there's something in it.
const overviewText = paragraphs(overview);
const responsibilityList = Array.isArray(responsibilities)
  ? responsibilities.map((item) => item.trim()).filter(Boolean)
  : [];
const responsibilityText = Array.isArray(responsibilities) ? [] : paragraphs(responsibilities);
const hasResponsibilities = responsibilityList.length > 0 || responsibilityText.length > 0;
const developmentItems = (development ?? [])
  .map((item) => ({ title: item.title.trim(), text: paragraphs(item.description) }))
  .filter((item) => item.title && item.text.length > 0);
const productionText = paragraphs(production);
const challengeItems = (challenges ?? [])
  .map((item) => ({
    title: item.title.trim(),
    challenge: paragraphs(item.challenge),
    solution: paragraphs(item.solution),
  }))
  .filter((item) => item.title && (item.challenge.length > 0 || item.solution.length > 0));
const highlightGroups = toCategories(highlights);
const technologyGroups = toCategories(technologies);
const resultText = paragraphs(result);
const clips = gameplay ?? [];
const shots = gallery ?? [];
const allLinks = projectLinks(links);
// The hero carries the main actions; the closing Links section lists them all.
const heroLinks = allLinks.slice(0, 2);
const hasBody =
  overviewText.length > 0 ||
  hasResponsibilities ||
  developmentItems.length > 0 ||
  productionText.length > 0 ||
  challengeItems.length > 0 ||
  highlightGroups.length > 0 ||
  technologyGroups.length > 0;
---

<BaseLayout title={title} description={summary} image={ogImage}>
  <article>
    {/* 1. Hero: what it is and the key facts */}
    <Container as="header" class="hero">
      <div class="heading">
        <h1 style={morph.title}>{title}</h1>
        <p class="pitch">{summary}</p>
        {
          inProgress && (
            <p class="wip">
              <Badge live>Case study in progress</Badge>{" "}
              <span>{inProgressNote}</span>
            </p>
          )
        }
      </div>
      <aside class="details" aria-label="Project details">
        <ProjectMeta project={project.data} />
        {
          heroLinks.length > 0 && (
            <div class="actions">
              {heroLinks.map((link, index) => (
                <Button href={link.href} variant={index === 0 ? 'primary' : 'secondary'}>
                  {link.label}
                </Button>
              ))}
            </div>
          )
        }
      </aside>
    </Container>

    {/* 2. Main visual: the video takes priority, otherwise the cover */}
    {
      trailer ? (
        <Container as="section" class="feature" aria-label={`${title} trailer`}>
          <YouTubeVideo url={trailer} title={`${title} trailer`} poster={trailerPoster ?? cover} />
        </Container>
      ) : (
        cover && (
          <Container class="feature cover">
            <Picture
              src={cover}
              alt={coverAlt ?? ''}
              formats={['avif', 'webp']}
              widths={[640, 960, 1280, 1920, 2560]}
              sizes="(min-width: 90rem) 90rem, 100vw"
              loading="eager"
              fetchpriority="high"
              style={morph.cover}
            />
          </Container>
        )
      )
    }

    {/* 3–7. The case study */}
    {
      hasBody && (
        <Container class="body">
          {overviewText.length > 0 && (
            <section class="text-section" aria-labelledby="overview-title">
              <h2 id="overview-title">Overview.</h2>
              <div class="prose">
                {overviewText.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </section>
          )}

          {hasResponsibilities && (
            <section class="text-section" aria-labelledby="role-title">
              <h2 id="role-title">My role.</h2>
              <div class="stack">
                {(role || team) && (
                  <dl class="facts">
                    {role && (
                      <div>
                        <dt>Role</dt>
                        <dd>{role}</dd>
                      </div>
                    )}
                    {team && (
                      <div>
                        <dt>Team</dt>
                        <dd>{team}</dd>
                      </div>
                    )}
                  </dl>
                )}
                <div class="stack-tight">
                  <p class="label">Responsibilities</p>
                  {responsibilityList.length > 0 ? (
                    <CategoryList groups={[{ category: '', items: responsibilityList }]} />
                  ) : (
                    <div class="prose">
                      {responsibilityText.map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </section>
          )}

          {developmentItems.length > 0 && (
            <section class="text-section" aria-labelledby="development-title">
              <h2 id="development-title">Development.</h2>
              <div class="stack">
                {developmentItems.map((item) => (
                  <div class="sub">
                    <h3>{item.title}</h3>
                    <div class="prose">
                      {item.text.map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}

          {productionText.length > 0 && (
            <section class="text-section" aria-labelledby="production-title">
              <h2 id="production-title">Production.</h2>
              <div class="prose">
                {productionText.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </section>
          )}

          {challengeItems.length > 0 && (
            <section class="text-section" aria-labelledby="challenges-title">
              <h2 id="challenges-title">{'Challenges & solutions.'}</h2>
              <div class="stack">
                {challengeItems.map((item) => (
                  <div class="sub">
                    <h3>{item.title}</h3>
                    <dl class="challenge">
                      {item.challenge.length > 0 && (
                        <div>
                          <dt>Challenge</dt>
                          <dd class="prose">
                            {item.challenge.map((paragraph) => (
                              <p>{paragraph}</p>
                            ))}
                          </dd>
                        </div>
                      )}
                      {item.solution.length > 0 && (
                        <div>
                          <dt>Solution</dt>
                          <dd class="prose">
                            {item.solution.map((paragraph) => (
                              <p>{paragraph}</p>
                            ))}
                          </dd>
                        </div>
                      )}
                    </dl>
                  </div>
                ))}
              </div>
            </section>
          )}

          {highlightGroups.length > 0 && (
            <section class="text-section" aria-labelledby="highlights-title">
              <h2 id="highlights-title">Technical highlights.</h2>
              <CategoryList groups={highlightGroups} />
            </section>
          )}

          {technologyGroups.length > 0 && (
            <section class="text-section" aria-labelledby="technologies-title">
              <h2 id="technologies-title">Technologies.</h2>
              <CategoryList groups={technologyGroups} variant="rows" />
            </section>
          )}
        </Container>
      )
    }

    {/* 8. Gameplay: extra video clips */}
    {
      clips.length > 0 && (
        <Container as="section" class="media-section" aria-labelledby="gameplay-title">
          <h2 id="gameplay-title">Gameplay.</h2>
          <div class="grid">
            {clips.map((clip) => (
              <figure>
                <YouTubeVideo url={clip.video} title={clip.title} poster={clip.poster} />
                {clip.poster && <figcaption>{clip.title}</figcaption>}
              </figure>
            ))}
          </div>
        </Container>
      )
    }

    {/* 9. Screenshots and GIFs (GIFs served as-is: converting them would drop the animation) */}
    {
      shots.length > 0 && (
        <Container as="section" class="media-section" aria-labelledby="screenshots-title">
          <h2 id="screenshots-title">Screenshots.</h2>
          <ul role="list" class="grid">
            {shots.map((shot) => (
              <li>
                {shot.image.format === 'gif' ? (
                  <img
                    src={shot.image.src}
                    width={shot.image.width}
                    height={shot.image.height}
                    alt={shot.alt}
                    loading="lazy"
                    decoding="async"
                    class="shot"
                  />
                ) : (
                  <Image
                    src={shot.image}
                    alt={shot.alt}
                    widths={[640, 960, 1280]}
                    sizes="(min-width: 48em) 50vw, 100vw"
                    class="shot"
                  />
                )}
              </li>
            ))}
          </ul>
        </Container>
      )
    }

    {/* 10–11. Result and links */}
    {
      (resultText.length > 0 || allLinks.length > 0) && (
        <Container class="body closing">
          {resultText.length > 0 && (
            <section class="text-section" aria-labelledby="result-title">
              <h2 id="result-title">Result.</h2>
              <div class="prose">
                {resultText.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </section>
          )}
          {allLinks.length > 0 && (
            <section class="text-section" aria-labelledby="links-title">
              <h2 id="links-title">Links.</h2>
              <div class="actions">
                {allLinks.map((link, index) => (
                  <Button href={link.href} variant={index === 0 ? 'primary' : 'secondary'}>
                    {link.label}
                  </Button>
                ))}
              </div>
            </section>
          )}
        </Container>
      )
    }
  </article>

  {
    (prev || next) && (
      <Container as="nav" class="pager" aria-label="More projects">
        {prev && (
          <a class="prev" href={`/work/${prev.id}`} rel="prev">
            <span class="direction">Previous project</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        )}
        {next && (
          <a class="next" href={`/work/${next.id}`} rel="next">
            <span class="direction">Next project</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        )}
      </Container>
    )
  }
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-2xl);
  }

  .heading {
    display: grid;
    gap: var(--space-l);
  }

  .pitch {
    font-size: var(--text-lg);
  }

  .wip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
    color: var(--color-text-muted);
  }

  .details {
    display: grid;
    gap: var(--space-xl);
    align-content: start;
    padding-top: var(--space-l);
    border-top: var(--border-thin) solid var(--color-line);
  }

  .details:not(:has(dl, .actions)) {
    display: none;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .cover :global(img) {
    width: 100%;
    max-height: 80svh;
    object-fit: cover;
    border: var(--border-thin) solid var(--color-line);
  }

  .body {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-2xl);
  }

  /* Each section: heading on the left, content on the right (desktop). */
  .text-section {
    display: grid;
    gap: var(--space-l);
    padding-top: var(--space-l);
    border-top: var(--border-thin) solid var(--color-line);
  }

  .text-section h2 {
    font-size: var(--text-2xl);
  }

  .prose {
    display: grid;
    gap: var(--space-m);
    max-width: 52rem;
    font-size: var(--text-lg);
  }

  .stack {
    display: grid;
    gap: var(--space-xl);
  }

  .stack-tight {
    display: grid;
    gap: var(--space-s);
  }

  .label {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-2xl);
    font-size: var(--text-lg);
  }

  .sub {
    display: grid;
    gap: var(--space-s);
  }

  .challenge {
    display: grid;
    gap: var(--space-l);
  }

  .challenge > div {
    display: grid;
    gap: var(--space-xs);
  }

  .feature {
    padding-bottom: var(--space-xl);
  }

  .media-section {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-2xl);
  }

  .grid {
    display: grid;
    gap: var(--space-l) var(--space-m);
  }

  figure {
    display: grid;
    gap: var(--space-s);
  }

  figcaption {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .shot {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: var(--border-thin) solid var(--color-line);
  }

  .pager {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-2xl);
  }

  .pager a {
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-xl);
    border-top: var(--border-thin) solid var(--color-line);
    text-decoration: none;
  }

  .direction {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .pager-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
    text-transform: uppercase;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .pager a:hover .pager-title {
    color: var(--color-accent);
  }

  @media (min-width: 48em) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .challenge {
      grid-template-columns: 1fr 1fr;
    }

    .pager {
      grid-template-columns: 1fr 1fr;
    }

    .next {
      grid-column: 2;
      text-align: right;
    }
  }

  @media (min-width: 64em) {
    .hero {
      grid-template-columns: 2fr 1fr;
      align-items: end;
    }

    .text-section {
      grid-template-columns: 1fr 2fr;
      align-items: start;
    }
  }
</style>
